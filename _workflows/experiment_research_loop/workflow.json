{
  "extension_policy": {
    "allow_dynamic_tasks": true,
    "allow_execution": false,
    "allowed_task_types": [
      "error_analysis",
      "scientific_critique",
      "evidence_review",
      "falsification_planning"
    ],
    "max_tasks": 8
  },
  "goal": "Run a bounded evidence-driven research loop from hypothesis through review and outcome",
  "inputs": [
    "project_objective",
    "dataset_version",
    "research_context"
  ],
  "nodes": [
    {
      "capability": "research",
      "node_id": "define_objective",
      "prompt": {
        "prompt_id": "experiment_planning",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "experiment_planning",
        "version": "1.0"
      },
      "skill": "experiment-planning",
      "task_type": "research_scope",
      "writes": [
        {
          "artifact_id": "research_scope",
          "artifact_type": "scope"
        }
      ]
    },
    {
      "capability": "critique",
      "dependencies": [
        "define_objective"
      ],
      "node_id": "inspect_prior_evidence",
      "prompt": {
        "prompt_id": "scientific_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "scientific_review",
        "version": "1.0"
      },
      "skill": "scientist-review",
      "task_type": "evidence_review",
      "writes": [
        {
          "artifact_id": "prior_evidence",
          "artifact_type": "evidence"
        }
      ]
    },
    {
      "capability": "research",
      "dependencies": [
        "inspect_prior_evidence"
      ],
      "node_id": "plan_next_attempt",
      "prompt": {
        "prompt_id": "experiment_planning",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "experiment_planning",
        "version": "1.0"
      },
      "skill": "experiment-planning",
      "task_type": "experiment_planning",
      "writes": [
        {
          "artifact_id": "experiment_plan",
          "artifact_type": "plan"
        }
      ]
    },
    {
      "capability": "evaluation",
      "decision_gate": {
        "action_type": "run_experiment",
        "allowing_decision_required": true,
        "gate_id": "research_attempt"
      },
      "dependencies": [
        "plan_next_attempt"
      ],
      "node_id": "authorize_attempt",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "decision_review",
      "writes": [
        {
          "artifact_id": "attempt_decision",
          "artifact_type": "decision"
        }
      ]
    },
    {
      "capability": "research",
      "decision_binding": "attempt_decision",
      "dependencies": [
        "authorize_attempt"
      ],
      "experiment_plan_binding": "experiment_plan",
      "node_id": "execute_attempt",
      "prompt": {
        "prompt_id": "experiment_planning",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "experiment_planning",
        "version": "1.0"
      },
      "skill": "remote-execution",
      "task_type": "experiment_execution",
      "writes": [
        {
          "artifact_id": "tool_runs",
          "artifact_type": "results"
        }
      ]
    },
    {
      "capability": "critique",
      "dependencies": [
        "execute_attempt"
      ],
      "node_id": "interpret_results",
      "prompt": {
        "prompt_id": "scientific_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "scientific_review",
        "version": "1.0"
      },
      "skill": "scientist-review",
      "task_type": "result_review",
      "writes": [
        {
          "artifact_id": "attempt_interpretation",
          "artifact_type": "review"
        }
      ]
    },
    {
      "agent_profile": {
        "prompt_id": "scientific_critic",
        "version": "1.1"
      },
      "capability": "critique",
      "completion_mode": "conditional",
      "dependencies": [
        "interpret_results"
      ],
      "node_id": "critique_and_falsify",
      "prompt": {
        "prompt_id": "scientific_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "scientific_review",
        "version": "1.0"
      },
      "skill": "scientist-review",
      "task_type": "scientific_critique",
      "writes": [
        {
          "artifact_id": "critique",
          "artifact_type": "critique"
        }
      ]
    },
    {
      "capability": "research",
      "dependencies": [
        "critique_and_falsify"
      ],
      "node_id": "route_next_attempt",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "research_loop_control",
      "writes": [
        {
          "artifact_id": "research_loop_state",
          "artifact_type": "state"
        }
      ]
    },
    {
      "capability": "evaluation",
      "dependencies": [
        "route_next_attempt"
      ],
      "node_id": "generate_report",
      "prompt": {
        "prompt_id": "report_generation",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "report_generation",
        "version": "1.0"
      },
      "skill": "report-generation",
      "task_type": "report_generation",
      "writes": [
        {
          "artifact_id": "static_report",
          "artifact_type": "report"
        }
      ]
    },
    {
      "capability": "evaluation",
      "dependencies": [
        "generate_report"
      ],
      "node_id": "record_outcome",
      "prompt": {
        "prompt_id": "outcome_recording",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "outcome_recording",
        "version": "1.0"
      },
      "skill": "outcome-recording",
      "task_type": "outcome_recording",
      "writes": [
        {
          "artifact_id": "project_outcome",
          "artifact_type": "outcome"
        }
      ]
    }
  ],
  "outputs": [
    "experiment_plan",
    "tool_runs",
    "scientist_review",
    "research_loop_state",
    "static_report",
    "project_outcome"
  ],
  "version": "1.0",
  "workflow_id": "experiment_research_loop"
}
