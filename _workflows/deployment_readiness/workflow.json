        "allowing_decision_required": true,
        "gate_id": "deployment_authorization",
        "required": true
      },
      "dependencies": [
        "assess_readiness"
      ],
      "node_id": "authorize_deployment",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "deployment",
      "writes": [
        {
          "artifact_id": "deployment_decision",
          "artifact_type": "decision"
        }
      ]
