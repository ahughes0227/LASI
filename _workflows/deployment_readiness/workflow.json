      ]
    },
    {
      "capability": "evaluation",
      "dependencies": [
        "intake_artifact"
      ],
      "node_id": "review_operations",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "operational_readiness_review",
      "writes": [
        {
          "artifact_id": "operational_review",
          "artifact_type": "review"
        }
      ]
    },
    {
      "capability": "evaluation",
      "dependencies": [
        "validate_evidence",
        "review_operations"
      ],
      "node_id": "assess_readiness",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "readiness_assessment",
