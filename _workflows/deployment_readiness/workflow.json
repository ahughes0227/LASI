      "node_id": "intake_artifact",
      "prompt": {
        "prompt_id": "outcome_recording",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "outcome_recording",
        "version": "1.0"
      },
      "skill": "outcome-recording",
      "task_type": "deployment_intake",
      "writes": [
