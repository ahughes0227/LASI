      "node_id": "record_production_outcome",
      "prompt": {
        "prompt_id": "outcome_recording",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "outcome_recording",
        "version": "1.0"
      },
      "skill": "outcome-recording",
      "task_type": "outcome_recording",
      "writes": [
        {
          "artifact_id": "production_outcome",
          "artifact_type": "outcome"
        }
      ]
    }
