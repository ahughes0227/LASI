{
  "extension_policy": {
    "allow_dynamic_tasks": true,
    "allow_execution": false,
    "allowed_task_types": [
      "scientific_critique",
      "evidence_review"
    ],
    "max_tasks": 4
  },
  "goal": "Identify why model performance is limited and produce a report",
  "inputs": [
    "dataset_manifest",
    "project_objectives"
  ],
  "nodes": [
    {
      "agent_profile": {
        "prompt_id": "default_worker",
        "version": "1.0"
      },
      "capability": "eda",
      "node_id": "intake",
      "prompt": {
        "prompt_id": "dataset_intake",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "dataset_intake",
        "version": "1.0"
      },
      "skill": "dataset-intake",
      "task_type": "dataset_intake",
      "writes": [
        {
          "artifact_id": "dataset_intake",
          "artifact_type": "intake"
        }
      ]
    },
    {
      "capability": "eda",
      "dependencies": [
        "intake"
      ],
      "node_id": "validate",
      "prompt": {
        "prompt_id": "dataset_characterization",
        "version": "1.0"
      },
      "reads": [
        {
          "artifact_id": "dataset_intake",
          "artifact_type": "intake"
        }
      ],
      "rubric": {
        "rubric_id": "dataset_intake",
        "version": "1.0"
      },
      "skill": "dataset-characterization",
      "task_type": "dataset_validation",
      "writes": [
        {
          "artifact_id": "dataset_validation",
          "artifact_type": "validation"
        }
      ]
    },
    {
      "capability": "eda",
      "dependencies": [
        "validate"
      ],
      "node_id": "characterize",
      "prompt": {
        "prompt_id": "dataset_characterization",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "dataset_intake",
        "version": "1.0"
      },
      "skill": "dataset-characterization",
      "task_type": "dataset_characterization",
      "writes": [
        {
          "artifact_id": "dataset_characterization",
          "artifact_type": "characterization"
        }
      ]
    },
    {
      "capability": "research",
      "dependencies": [
        "characterize"
      ],
      "node_id": "plan_experiments",
      "prompt": {
        "prompt_id": "experiment_planning",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "experiment_planning",
        "version": "1.0"
      },
      "skill": "experiment-planning",
      "task_type": "experiment_planning",
      "writes": [
        {
          "artifact_id": "experiment_plan",
          "artifact_type": "plan"
        }
      ]
    },
    {
      "capability": "evaluation",
      "decision_gate": {
        "action_type": "run_experiment",
        "allowing_decision_required": true,
        "gate_id": "experiment_authorization"
      },
      "dependencies": [
        "plan_experiments"
      ],
      "node_id": "authorize_experiment_plan",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "decision_review",
      "writes": [
        {
          "artifact_id": "experiment_decision",
          "artifact_type": "decision"
        }
      ]
    },
    {
      "activation": {
        "when": "experiment_plan_ready"
      },
      "capability": "research",
      "completion_mode": "conditional",
      "decision_binding": "experiment_decision",
      "dependencies": [
        "authorize_experiment_plan"
      ],
      "experiment_plan_binding": "experiment_plan",
      "node_id": "run_experiments",
      "prompt": {
        "prompt_id": "experiment_planning",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "experiment_planning",
        "version": "1.0"
      },
      "skill": "remote-execution",
      "task_type": "experiment_execution",
      "writes": [
        {
          "artifact_id": "experiment_results",
          "artifact_type": "results"
        }
      ]
    },
    {
      "capability": "critique",
      "completion_mode": "conditional",
      "dependencies": [
        "run_experiments"
      ],
      "node_id": "scientist_review",
      "prompt": {
        "prompt_id": "scientific_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "scientific_review",
        "version": "1.0"
      },
      "skill": "scientist-review",
      "task_type": "scientific_review",
      "writes": [
        {
          "artifact_id": "scientist_review",
          "artifact_type": "review"
        }
      ]
    },
    {
      "capability": "evaluation",
      "completion_mode": "conditional",
      "decision_gate": {
        "action_type": "recommendation",
        "allowing_decision_required": true,
        "gate_id": "recommendation_review"
      },
      "dependencies": [
        "scientist_review"
      ],
      "node_id": "review_recommendations",
      "prompt": {
        "prompt_id": "decision_review",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "decision_review",
        "version": "1.0"
      },
      "skill": "decision-review",
      "task_type": "decision_review",
      "writes": [
        {
          "artifact_id": "recommendation_decision",
          "artifact_type": "decision"
        }
      ]
    },
    {
      "capability": "evaluation",
      "dependencies": [
        "review_recommendations"
      ],
      "node_id": "generate_report",
      "prompt": {
        "prompt_id": "report_generation",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "report_generation",
        "version": "1.0"
      },
      "skill": "report-generation",
      "task_type": "report_generation",
      "writes": [
        {
          "artifact_id": "static_report",
          "artifact_type": "report"
        }
      ]
    },
    {
      "capability": "evaluation",
      "dependencies": [
        "generate_report"
      ],
      "node_id": "record_outcome",
      "prompt": {
        "prompt_id": "outcome_recording",
        "version": "1.0"
      },
      "rubric": {
        "rubric_id": "outcome_recording",
        "version": "1.0"
      },
      "skill": "outcome-recording",
      "task_type": "outcome_recording",
      "writes": [
        {
          "artifact_id": "project_outcome",
          "artifact_type": "outcome"
        }
      ]
    }
  ],
  "outputs": [
    "dataset_characterization",
    "experiment_plan",
    "scientist_review",
    "decision_record",
    "static_report",
    "project_outcome"
  ],
  "version": "1.0",
  "workflow_id": "dataset_diagnostic"
}
