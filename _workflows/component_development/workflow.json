  "extension_policy": {"allow_dynamic_tasks": false, "allow_execution": false, "max_tasks": 0},
  "nodes": [
    {"node_id": "specify_component", "task_type": "component_specification", "prompt": {"prompt_id": "knowledge_curation", "version": "1.0"}, "rubric": {"rubric_id": "knowledge_curation", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "component_spec", "artifact_type": "contract"}]},
    {"node_id": "discover_components", "task_type": "component_discovery", "dependencies": ["specify_component"], "prompt": {"prompt_id": "decision_review", "version": "1.0"}, "rubric": {"rubric_id": "decision_review", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "candidates", "artifact_type": "discovery"}]},
    {"node_id": "resolve_component", "task_type": "component_resolution", "dependencies": ["discover_components"], "prompt": {"prompt_id": "decision_review", "version": "1.0"}, "rubric": {"rubric_id": "decision_review", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "resolution", "artifact_type": "resolution"}]},
    {"node_id": "analyze_impact", "task_type": "component_impact_analysis", "dependencies": ["resolve_component"], "prompt": {"prompt_id": "decision_review", "version": "1.0"}, "rubric": {"rubric_id": "decision_review", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "impact", "artifact_type": "analysis"}]},
    {"node_id": "research_gaps", "task_type": "component_research", "completion_mode": "conditional", "dependencies": ["analyze_impact"], "prompt": {"prompt_id": "knowledge_curation", "version": "1.0"}, "rubric": {"rubric_id": "knowledge_curation", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "research_decisions", "artifact_type": "research"}]},
    {"node_id": "freeze_build_plan", "task_type": "component_build_planning", "dependencies": ["research_gaps"], "prompt": {"prompt_id": "experiment_planning", "version": "1.0"}, "rubric": {"rubric_id": "experiment_planning", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "build_plan", "artifact_type": "plan"}]},
    {"node_id": "build_package", "task_type": "component_package_build", "dependencies": ["freeze_build_plan"], "prompt": {"prompt_id": "experiment_planning", "version": "1.0"}, "rubric": {"rubric_id": "experiment_planning", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "package", "artifact_type": "package"}]},
    {"node_id": "validate_package", "task_type": "component_package_validation", "dependencies": ["build_package"], "prompt": {"prompt_id": "decision_review", "version": "1.0"}, "rubric": {"rubric_id": "decision_review", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "writes": [{"artifact_id": "validation", "artifact_type": "validation"}]},
    {"node_id": "propose_registration", "task_type": "component_registration_proposal", "dependencies": ["validate_package"], "prompt": {"prompt_id": "decision_review", "version": "1.0"}, "rubric": {"rubric_id": "decision_review", "version": "1.0"}, "skill": "component-development", "capability": "component_development", "decision_gate": {"gate_id": "component_registration", "action_type": "update_toolbox", "required": true}, "writes": [{"artifact_id": "registration_proposal", "artifact_type": "proposal"}]},
    {"node_id": "review_registration", "task_type": "decision_review", "dependencies": ["propose_registration"], "prompt": {"prompt_id": "decision_review", "version": "1.0"}, "rubric": {"rubric_id": "decision_review", "version": "1.0"}, "skill": "decision-review", "capability": "evaluation", "decision_gate": {"gate_id": "component_installation", "action_type": "install_workflow_or_capability", "required": true}, "writes": [{"artifact_id": "registration_decision", "artifact_type": "decision"}]}
  ]
