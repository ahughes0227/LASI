{
  "$defs": {
    "WorkflowActivation": {
      "additionalProperties": false,
      "description": "Declarative, inspectable activation predicate for a node.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "when": {
          "default": "always",
          "title": "When",
          "type": "string"
        }
      },
      "title": "WorkflowActivation",
      "type": "object"
    },
    "WorkflowArtifactContract": {
      "additionalProperties": false,
      "description": "Typed handoff paths for one workflow node.",
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "uri_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri Pattern"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type"
      ],
      "title": "WorkflowArtifactContract",
      "type": "object"
    },
    "WorkflowDecisionGate": {
      "additionalProperties": false,
      "description": "Decision binding required before a governed node can be proposed.",
      "properties": {
        "action_type": {
          "title": "Action Type",
          "type": "string"
        },
        "allowing_decision_required": {
          "default": false,
          "title": "Allowing Decision Required",
          "type": "boolean"
        },
        "gate_id": {
          "title": "Gate Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "gate_id",
        "action_type"
      ],
      "title": "WorkflowDecisionGate",
      "type": "object"
    },
    "WorkflowExtensionPolicy": {
      "additionalProperties": false,
      "description": "Boundaries for coordinator-created dynamic tasks.",
      "properties": {
        "allow_dynamic_tasks": {
          "default": false,
          "title": "Allow Dynamic Tasks",
          "type": "boolean"
        },
        "allow_execution": {
          "default": false,
          "title": "Allow Execution",
          "type": "boolean"
        },
        "allowed_task_types": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Task Types",
          "type": "array"
        },
        "max_tasks": {
          "default": 0,
          "minimum": 0,
          "title": "Max Tasks",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "WorkflowExtensionPolicy",
      "type": "object"
    },
    "WorkflowNode": {
      "additionalProperties": false,
      "description": "Declarative unit of workflow routing and typed handoff.",
      "properties": {
        "activation": {
          "$ref": "#/$defs/WorkflowActivation"
        },
        "agent_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowPromptRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "completion_mode": {
          "default": "required",
          "title": "Completion Mode",
          "type": "string"
        },
        "decision_binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Binding"
        },
        "decision_gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowDecisionGate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "escalation_behavior": {
          "default": "record_and_stop",
          "title": "Escalation Behavior",
          "type": "string"
        },
        "experiment_plan_binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Plan Binding"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "prompt": {
          "$ref": "#/$defs/WorkflowPromptRef"
        },
        "reads": {
          "items": {
            "$ref": "#/$defs/WorkflowArtifactContract"
          },
          "title": "Reads",
          "type": "array"
        },
        "rubric": {
          "$ref": "#/$defs/WorkflowRubricRef"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skill": {
          "title": "Skill",
          "type": "string"
        },
        "skip_policy": {
          "$ref": "#/$defs/WorkflowSkipPolicy"
        },
        "task_type": {
          "title": "Task Type",
          "type": "string"
        },
        "writes": {
          "items": {
            "$ref": "#/$defs/WorkflowArtifactContract"
          },
          "title": "Writes",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "task_type",
        "prompt",
        "rubric",
        "skill",
        "capability"
      ],
      "title": "WorkflowNode",
      "type": "object"
    },
    "WorkflowPromptRef": {
      "additionalProperties": false,
      "description": "Immutable reference to a versioned workflow instruction asset.",
      "properties": {
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "version"
      ],
      "title": "WorkflowPromptRef",
      "type": "object"
    },
    "WorkflowRubricRef": {
      "additionalProperties": false,
      "description": "Immutable reference to a versioned workflow acceptance asset.",
      "properties": {
        "rubric_id": {
          "title": "Rubric Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rubric_id",
        "version"
      ],
      "title": "WorkflowRubricRef",
      "type": "object"
    },
    "WorkflowSkipPolicy": {
      "additionalProperties": false,
      "description": "Explicit handling for conditional, failed, and blocked work.",
      "properties": {
        "allowed_statuses": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Statuses",
          "type": "array"
        },
        "downstream_behavior": {
          "default": "continue",
          "title": "Downstream Behavior",
          "type": "string"
        },
        "record_reason": {
          "default": true,
          "title": "Record Reason",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "WorkflowSkipPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned JSON workflow package; the workflow control-plane authority.",
  "properties": {
    "extension_policy": {
      "$ref": "#/$defs/WorkflowExtensionPolicy"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "inputs": {
      "items": {
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "outputs": {
      "items": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "version",
    "goal",
    "nodes"
  ],
  "title": "WorkflowDefinition",
  "type": "object"
}
