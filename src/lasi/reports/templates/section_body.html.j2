{% if section.section_status != "complete" %}<div class="state-note"><strong>Section state:</strong> {{ section.section_status|replace("_", " ") }}{% if section.missing_or_blocked_reason %}<br><span>{{ section.missing_or_blocked_reason }}</span>{% endif %}</div>{% endif %}
{% if section.summary %}<p class="summary">{{ section.summary }}</p>{% endif %}
{% if section.content %}<div class="content-grid">{% for key, value in section.content|dictsort %}<div class="content-item"><h3>{{ key|replace("_", " ")|title }}</h3>{% if value is mapping %}<dl>{% for child_key, child_value in value|dictsort %}<div><dt>{{ child_key|replace("_", " ")|title }}</dt><dd>{{ child_value }}</dd></div>{% endfor %}</dl>{% elif value is sequence and value is not string %}<ul>{% for item in value %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<p>{{ value }}</p>{% endif %}</div>{% endfor %}</div>{% endif %}
{% if section.source_records or section.source_artifacts %}<div class="references"><h3>Section Provenance</h3>{% for ref in section.source_records %}<code>{{ ref }}</code>{% endfor %}{% for ref in section.source_artifacts %}<code>{{ ref }}</code>{% endfor %}</div>{% endif %}
