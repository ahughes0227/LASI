{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lasi-admin",
  "instructions": ["AGENTS.md", "_architecture/01_ARCHITECTURE.md", "_core/glossary.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "share": "disabled",
  "agent": {
    "lasi-admin": {
      "mode": "primary",
      "description": "Controls durable LASI assignment lifecycle without running research inline.",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "lasi-coordinator": {
      "mode": "subagent",
      "description": "Internal ephemeral coordinator invoked by the durable project runner.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  }
}
